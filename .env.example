# ============================================================
# Brandex — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to git.
# ============================================================

# ─── API Server ─────────────────────────────────────────────
# Required by the Express API server (artifacts/api-server)
PORT=8080

# ─── Database (Neon PostgreSQL) ─────────────────────────────
# Required: runtime database connection
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Optional: direct/unpooled connection for migrations and drizzle-kit push
# Use this only for: pnpm --filter @workspace/db run push
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ─── Google Sheets Integration ──────────────────────────────
# Required for the "Sync G-Sheets" feature
GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here

# Optional: enables write-back from app edits → Google Sheets
# Get this from: Google Apps Script > Deploy > Web App URL
GOOGLE_SHEETS_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# ─── Session Security ───────────────────────────────────────
SESSION_SECRET=your_random_secret_string_here

# ─── Mobile App (Expo) ──────────────────────────────────────
# Required by the Expo mobile app to reach the API server.
# Local dev:      EXPO_PUBLIC_DOMAIN=localhost:8080
# Production:     EXPO_PUBLIC_DOMAIN=your-api-domain.vercel.app
EXPO_PUBLIC_DOMAIN=localhost:8080

# ─── Web App (Vite) ─────────────────────────────────────────
# Optional — defaults to 5173 if not set
# PORT=5173
# Optional — defaults to '/' if not set (correct for Vercel)
# BASE_PATH=/
